{
  "name": "developer-sidecar",
  "version": "0.1.0",
  "description": "A Claude Code plugin that shows what Claude is doing as live technical-drawing scenes and plain-English explanations.",
  "license": "MIT",
  "author": "Shiv Vyas",
  "homepage": "https://github.com/shivvyas2/developer-sidecar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivvyas2/developer-sidecar.git"
  },
  "bugs": {
    "url": "https://github.com/shivvyas2/developer-sidecar/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude",
    "anthropic",
    "ai",
    "vibecoding",
    "developer-tools",
    "explainer",
    "education"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:tokens": "vitest run -c bench/explainer/vitest.config.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-concurrent.mjs 3",
    "test:mod": "node scripts/test-mod.mjs",
    "e2e": "playwright test -c apps/web/playwright.config.ts",
    "look": "node --experimental-strip-types --no-warnings scripts/look.mjs",
    "release:tree": "node scripts/release-tree.mjs",
    "release:check": "pnpm build && node scripts/release-tree.mjs && claude plugin validate release-tree/plugin && claude plugin validate ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sidecar/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
